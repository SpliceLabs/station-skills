{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "station/harness@2",
  "description": "What Station hands a `station/harness@2` harness and the only answer it accepts back. See harness-v2.md. Also checked by Station, beyond this schema: (1) Station counts a string's length in UTF-8 bytes where the contract says bytes, and otherwise in UTF-16 code units; the schema counts characters at the same bound, so a string with characters outside ASCII can pass the schema and still be too long. (2) Each item's `fields` and `raw`, and each output's `payload`, serializes to at most 16384 UTF-8 bytes. (3) The context's `content` serializes to at most 65536 UTF-8 bytes. (4) No object anywhere in the answer holds a `__proto__`, `constructor` or `prototype` key, and nothing nests deeper than 40 levels (an opaque object, 32). (5) The reads hand over at most 50 items in all; reads of one docking are of one source contract, are not handed over twice, and repeat no item. (6) `run_id` is the run Station handed over, and `config_hash` the one the docking pinned. (7) Grounding: every output names a docking and an item Station handed over from it in the same call, by `ref` for a `station/source@2` read and by `item_id` for a `station/source@1` read; no item has two outputs; every `held_back` entry names an item handed over, once, that has no output. (8) A `blocked` answer carries no outputs. (9) `approved_by` is not blank. (10) In place of a result, any tool may answer the shared error answer, `errors.schema.json`.",
  "$defs": {
    "json": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/json"
          }
        }
      ]
    },
    "harness_run.arguments": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "reads": {
          "minItems": 1,
          "maxItems": 8,
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "contract": {
                    "type": "string",
                    "const": "station/source@2"
                  },
                  "docking": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,31}$"
                  },
                  "reference": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "simulated": {
                    "type": "boolean"
                  },
                  "items": {
                    "maxItems": 50,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "ref": {
                          "type": "string",
                          "maxLength": 256,
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                        },
                        "kind": {
                          "anyOf": [
                            {
                              "type": "string",
                              "enum": [
                                "company",
                                "person",
                                "deal",
                                "stage",
                                "note",
                                "task",
                                "space",
                                "page",
                                "comment"
                              ]
                            },
                            {
                              "type": "string",
                              "maxLength": 64,
                              "pattern": "^x-[a-z0-9]+(?:-[a-z0-9]+)*$"
                            }
                          ]
                        },
                        "remote_id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        },
                        "updated_at": {
                          "type": "string",
                          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                        },
                        "link": {
                          "anyOf": [
                            {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 2048
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "mapping_version": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[0-9a-f]{64}$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "fields": {
                          "type": "object",
                          "propertyNames": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          },
                          "additionalProperties": {
                            "$ref": "#/$defs/json"
                          }
                        },
                        "raw": {
                          "type": "object",
                          "propertyNames": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          },
                          "additionalProperties": {
                            "$ref": "#/$defs/json"
                          }
                        }
                      },
                      "required": [
                        "ref",
                        "kind",
                        "remote_id",
                        "updated_at",
                        "link",
                        "mapping_version",
                        "fields"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "contract",
                  "docking",
                  "reference",
                  "simulated",
                  "items"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "contract": {
                    "type": "string",
                    "const": "station/source@1"
                  },
                  "docking": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,31}$"
                  },
                  "reference": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "simulated": {
                    "type": "boolean"
                  },
                  "items": {
                    "maxItems": 50,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "item_id": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                        },
                        "fields": {
                          "type": "object",
                          "propertyNames": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          },
                          "additionalProperties": {
                            "$ref": "#/$defs/json"
                          }
                        }
                      },
                      "required": [
                        "item_id",
                        "fields"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "contract",
                  "docking",
                  "reference",
                  "simulated",
                  "items"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "brief": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 0,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "context": {
          "type": "object",
          "properties": {
            "context_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "content": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "additionalProperties": {
                "$ref": "#/$defs/json"
              }
            },
            "provenance": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "const": "station"
                },
                "revision": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                "approved_by": {
                  "type": "string",
                  "maxLength": 128
                },
                "content_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "source",
                "revision",
                "approved_by",
                "content_hash"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "context_id",
            "version",
            "content",
            "provenance"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "run_id",
        "reads",
        "brief",
        "context"
      ],
      "additionalProperties": false
    },
    "harness_run.answer": {
      "type": "object",
      "properties": {
        "contract": {
          "type": "string",
          "const": "station/harness@2"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "config_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "verdict": {
          "type": "string",
          "enum": [
            "blocked",
            "not-ready",
            "ready-with-caveats",
            "ready"
          ]
        },
        "findings": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "additionalProperties": {
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 0,
              "maxLength": 1000
            }
          }
        },
        "outputs": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "docking": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,31}$"
                  },
                  "ref": {
                    "type": "string",
                    "maxLength": 256,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  },
                  "payload": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "additionalProperties": {
                      "$ref": "#/$defs/json"
                    }
                  }
                },
                "required": [
                  "docking",
                  "ref",
                  "payload"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "docking": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,31}$"
                  },
                  "item_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                  },
                  "payload": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "additionalProperties": {
                      "$ref": "#/$defs/json"
                    }
                  }
                },
                "required": [
                  "docking",
                  "item_id",
                  "payload"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "held_back": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "docking": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,31}$"
                  },
                  "ref": {
                    "type": "string",
                    "maxLength": 256,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  }
                },
                "required": [
                  "docking",
                  "ref"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "docking": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,31}$"
                  },
                  "item_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                  }
                },
                "required": [
                  "docking",
                  "item_id"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "contract",
        "run_id",
        "config_hash",
        "verdict",
        "findings",
        "outputs",
        "held_back"
      ],
      "additionalProperties": false
    }
  }
}

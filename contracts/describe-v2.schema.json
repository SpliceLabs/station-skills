{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "station/describe@2",
  "description": "What a dockable service answers to `station_describe` (no arguments) when it also says what it is for. See describe-v2.md. Also checked by Station, beyond this schema: (1) Station counts a string's length in UTF-8 bytes where the contract says bytes, and otherwise in UTF-16 code units; the schema counts characters at the same bound, so a string with characters outside ASCII can pass the schema and still be too long. (2) Text a service writes for people or a model to read also holds no tag character (U+E0000 to U+E007F) and no lone surrogate; the `pattern` covers the rest of that rule. (3) When `models` is given, `model` is not null and is one of `models`, and no two models share the label `provider/model`. (4) Each example's `tool` is one of `tools`. (5) `kinds` is given exactly when `contract` is a source contract (`station/source@N`).",
  "type": "object",
  "properties": {
    "describe": {
      "type": "string",
      "const": "station/describe@2"
    },
    "contract": {
      "type": "string",
      "pattern": "^station\\/[a-z][a-z0-9-]*@[1-9][0-9]*$"
    },
    "name": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "config_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tools": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.-]{1,128}$"
      },
      "uniqueItems": true
    },
    "reads": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[^\\u0000-\\u0009\\u000b-\\u001f\\u007f-\\u009f\\u061c\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u2064\\u2066-\\u2069\\ufeff]*$"
      }
    },
    "writes": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[^\\u0000-\\u0009\\u000b-\\u001f\\u007f-\\u009f\\u061c\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u2064\\u2066-\\u2069\\ufeff]*$"
      },
      "uniqueItems": true
    },
    "data": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[^\\u0000-\\u0009\\u000b-\\u001f\\u007f-\\u009f\\u061c\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u2064\\u2066-\\u2069\\ufeff]*$"
      }
    },
    "model": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[^\\u0000-\\u0009\\u000b-\\u001f\\u007f-\\u009f\\u061c\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u2064\\u2066-\\u2069\\ufeff]*$"
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\u0000-\\u0009\\u000b-\\u001f\\u007f-\\u009f\\u061c\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u2064\\u2066-\\u2069\\ufeff]*$"
            }
          },
          "required": [
            "provider",
            "model"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "models": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[^\\u0000-\\u0009\\u000b-\\u001f\\u007f-\\u009f\\u061c\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u2064\\u2066-\\u2069\\ufeff]*$"
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\\u0000-\\u0009\\u000b-\\u001f\\u007f-\\u009f\\u061c\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u2064\\u2066-\\u2069\\ufeff]*$"
          }
        },
        "required": [
          "provider",
          "model"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280,
      "pattern": "^[^\\u0000-\\u0009\\u000b-\\u001f\\u007f-\\u009f\\u061c\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u2064\\u2066-\\u2069\\ufeff]*$"
    },
    "use_when": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[^\\u0000-\\u0009\\u000b-\\u001f\\u007f-\\u009f\\u061c\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u2064\\u2066-\\u2069\\ufeff]*$"
      }
    },
    "not_for": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[^\\u0000-\\u0009\\u000b-\\u001f\\u007f-\\u009f\\u061c\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u2064\\u2066-\\u2069\\ufeff]*$"
      }
    },
    "examples": {
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ask": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^\\u0000-\\u0009\\u000b-\\u001f\\u007f-\\u009f\\u061c\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u2064\\u2066-\\u2069\\ufeff]*$"
          },
          "tool": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,128}$"
          }
        },
        "required": [
          "ask",
          "tool"
        ],
        "additionalProperties": false
      }
    },
    "kinds": {
      "minItems": 1,
      "maxItems": 32,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "company",
              "person",
              "deal",
              "stage",
              "note",
              "task",
              "space",
              "page",
              "comment"
            ]
          },
          {
            "type": "string",
            "maxLength": 64,
            "pattern": "^x-[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        ]
      },
      "uniqueItems": true
    },
    "limits": {
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[^\\u0000-\\u0009\\u000b-\\u001f\\u007f-\\u009f\\u061c\\u200b-\\u200f\\u2028-\\u202e\\u2060-\\u2064\\u2066-\\u2069\\ufeff]*$"
      }
    }
  },
  "required": [
    "describe",
    "contract",
    "name",
    "version",
    "config_hash",
    "tools",
    "reads",
    "writes",
    "data",
    "model",
    "purpose",
    "use_when",
    "not_for",
    "examples",
    "limits"
  ],
  "additionalProperties": false
}
